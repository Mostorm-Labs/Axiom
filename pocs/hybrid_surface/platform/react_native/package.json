{
  "name": "@mostorm/axiom-poc05-react-native",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android:release": "cd android && gradle app:assembleRelease",
    "windows": "npx @react-native-community/cli run-windows",
    "windows:release": "powershell -ExecutionPolicy Bypass -File ../../tools/run_windows_rnw_shell.ps1",
    "windows:restore": "react-native autolink-windows",
    "start": "react-native start",
    "test:windows": "jest --config jest.config.windows.js"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-windows": "0.84.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-env": "7.28.3",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/codegen": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "typescript": "5.9.3",
    "@rnx-kit/jest-preset": "^0.3.1"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "codegenConfig": {
    "name": "AxiomPoc05Spec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "dev.mostorm.axiom.poc05"
    },
    "ios": {
      "components": {
        "AxiomHybridSurface": {
          "className": "AxiomHybridSurfaceComponentView"
        }
      }
    },
    "windows": {
      "namespace": "AxiomPoc05Codegen",
      "outputDirectory": "windows/AxiomPoc05/codegen",
      "separateDataTypes": true,
      "generators": ["componentsWindows"]
    }
  },
  "react-native-windows": {
    "init-windows": {
      "name": "AxiomPoc05",
      "namespace": "AxiomPoc05",
      "template": "cpp-app"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
