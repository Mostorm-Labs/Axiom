{
  "schema_version": 1,
  "profile": "poc01-minimal-v1",
  "description": "POC-01 Ganesh-only release SDK: PNG, FreeType and the minimum platform GPU backend.",
  "skia_commit": "b6d106297ff9ef2ff8094033695d045e87775581",
  "common_gn_args": {
