{
  "schema_version": 1,
  "profile": "poc04-richtext-v1",
  "description": "POC-04 Ganesh and SkParagraph SDK with bundled HarfBuzz and ICU; Windows, Web, and Android only.",
  "skia_commit": "b6d106297ff9ef2ff8094033695d045e87775581",
  "build_targets": [
    "skia",
    "modules/skparagraph:skparagraph",
    "modules/skshaper:skshaper",
    "modules/skunicode:skunicode"
  ],
  "module_header_dirs": [
    "modules/skparagraph/include",
    "modules/skshaper/include",
    "modules/skunicode/include"
  ],
  "module_headers": [
    "modules/skcms/skcms.h",
    "modules/skcms/src/skcms_public.h",
    "src/core/SkUTF.h"
  ],
  "licenses": {
    "HarfBuzz.txt": "third_party/externals/harfbuzz/COPYING",
    "ICU.txt": "third_party/externals/icu/LICENSE"
  },
  "fixture_fonts": {
    "resources/fonts/NotoSansCJK-VF-subset.otf.ttc": "noto_sans_cjk_subset"
  },
  "runtime_files": [
    {"target": "windows-x64-d3d12", "source": "icudtl.dat", "destination": "runtime/windows/icudtl.dat"}
  ],
  "common_gn_args": {
    "is_component_build": false,
    "is_official_build": true,
    "skia_enable_fontmgr_custom_embedded": true,
    "skia_enable_ganesh": true,
    "skia_enable_graphite": false,
    "skia_enable_pdf": false,
    "skia_enable_skparagraph": true,
    "skia_enable_skshaper": true,
    "skia_enable_skunicode": true,
    "skia_enable_svg": false,
    "skia_use_dawn": false,
    "skia_use_dng_sdk": false,
    "skia_use_expat": false,
    "skia_use_fontconfig": false,
    "skia_use_freetype": true,
    "skia_use_harfbuzz": true,
    "skia_use_icu": true,
    "skia_use_libjpeg_turbo_decode": false,
    "skia_use_libjpeg_turbo_encode": false,
    "skia_use_libpng_decode": true,
    "skia_use_libpng_encode": true,
    "skia_use_libwebp_decode": false,
    "skia_use_libwebp_encode": false,
    "skia_use_partition_alloc": false,
    "skia_use_piex": false,
    "skia_use_system_freetype2": false,
    "skia_use_system_harfbuzz": false,
    "skia_use_system_icu": false,
    "skia_use_system_libpng": false,
    "skia_use_system_zlib": false,
    "skia_use_wuffs": false
  },
  "targets": {
    "android-arm64-v8a-gles3": {
      "platform": "android",
      "arch": "arm64-v8a",
      "backend": "gles3",
      "output_name": "poc04-sdk-android-arm64",
      "gn_args": {
        "ndk_api": 26,
        "skia_use_gl": true,
        "skia_use_vulkan": false,
        "target_cpu": "arm64",
        "target_os": "android"
      },
      "libraries": ["libskparagraph.a", "libskshaper.a", "libskunicode_core.a", "libskunicode_icu.a", "libskia.a", "libskcms.a", "libfreetype2.a", "libpng.a", "libzlib.a"],
      "toolchain": {"android_ndk": "27.2.12479018", "api_level": 26}
    },
    "android-x86_64-gles3": {
      "platform": "android",
      "arch": "x86_64",
      "backend": "gles3",
      "output_name": "poc04-sdk-android-x64",
      "gn_args": {
        "ndk_api": 26,
        "skia_use_gl": true,
        "skia_use_vulkan": false,
        "target_cpu": "x64",
        "target_os": "android"
      },
      "libraries": ["libskparagraph.a", "libskshaper.a", "libskunicode_core.a", "libskunicode_icu.a", "libskia.a", "libskcms.a", "libfreetype2.a", "libpng.a", "libzlib.a"],
      "toolchain": {"android_ndk": "27.2.12479018", "api_level": 26}
    },
    "web-wasm-webgl2": {
      "platform": "web",
      "arch": "wasm32",
      "backend": "webgl2",
      "output_name": "poc04-sdk-web-wasm",
      "gn_args": {
        "skia_use_gl": true,
        "skia_use_vulkan": false,
        "skia_use_webgl": true,
        "target_cpu": "wasm",
        "target_os": "wasm"
      },
      "libraries": ["libskparagraph.wasm.a", "libskshaper.wasm.a", "libskunicode_core.wasm.a", "libskunicode_icu.wasm.a", "libskia.wasm.a", "libskcms.wasm.a", "libfreetype2.wasm.a", "libpng.wasm.a", "libzlib.wasm.a"],
      "toolchain": {"emscripten": "6.0.6", "llvm": "22.1.8", "pthread": false}
    },
    "windows-x64-d3d12": {
      "platform": "windows",
      "arch": "x64",
      "backend": "d3d12",
      "output_name": "poc04-sdk-windows-x64",
      "gn_args": {
        "skia_use_angle": false,
        "skia_use_direct3d": true,
        "skia_use_gl": false,
        "skia_use_vulkan": false,
        "target_cpu": "x64",
        "target_os": "win"
      },
      "libraries": ["skparagraph.lib", "skshaper.lib", "skunicode_core.lib", "skunicode_icu.lib", "skia.lib", "skcms.lib", "freetype2.lib", "zlib.lib"],
      "toolchain": {"llvm": "22.1.8"}
    }
  }
}
